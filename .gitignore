# Python
__pycache__/
*.py[cod]
.venv/
# ...and the same environment reached through a symlink, which `.venv/` does not match: a
# worktree that reuses another checkout's virtualenv links to it by absolute path, and
# `git add -A` then stages that link into the branch.
.venv

# Runtime artifacts
# An unfrozen run keeps its user data next to the repo (render.menus USER_DIR = ROOT), so
# these are written into the working tree: settings/saves, replays, and the crash dumps
# install_exception_hook(USER_DIR) leaves in diagnostics/.
saves/
replays/
diagnostics/
# the cpp window's rings (`main.py --renderer cpp` writes them beside the game)
cpp-window/
*.log

# OS
.DS_Store

# packaging
build/
dist/
*.dmg
netdiag/

# native build trees (CMake configure output, not sources)
render_cpp/build*/

# Artifact evidence: receipts, not media. What git carries is the JSON metrics plus the sheets that
# art/manifests/** pins by hash and tools/art/s07_registration.py verifies. Review movies, candidate
# zips and run logs are regenerable - they were 75 MB of the evidence tree on their own - so they stay
# on disk. Sheets are deliberately NOT excluded: a pinned sheet is evidence, and it has to be committable.
/artifacts/**/*.mp4
/artifacts/**/*.mov
/artifacts/**/*.zip
/artifacts/**/*.log
/artifacts/**/*.gif

# match replays written by a --smoke or local run
/match-*.json
