{
  "contract": "star-armada/visual-pack",
  "contract_major": 1,
  "id": "example:raider_addon",
  "name": "Example: raider add-on model",
  "version": "1.0.0",
  "requires": {
    "min_engine": "0.15.1",
    "contracts": [
      "star-armada/visual-pack/v1",
      "star-armada/model-manifest/v1"
    ],
    "gameplay_mod": "example_raider_mod"
  },
  "content": {
    "adds": [
      {
        "binding": "syndicate:raider",
        "manifest": "assets/models/syndicate_raider.json",
        "entity_source": "example_raider_mod"
      }
    ]
  },
  "roots": {
    "assets": "assets"
  },
  "notes": "Example additive pack: a namespaced model for an entity a gameplay mod defines. A model pack never creates units."
}
